# Copy to .env.local for development. NEVER commit real values. In production set these in the host's secret store.

# --- Database (PostgreSQL 15+, with the btree_gist extension available). Supabase: use the Session/Direct connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking
DATABASE_SSL=false            # set true for hosted databases (Supabase requires TLS)

# --- App
APP_BASE_URL=http://localhost:3000
APP_SECRET=replace-with-at-least-32-random-characters   # signs manage-link / hold tokens: `openssl rand -base64 48`
ORG_SLUG=lotus-demo                                      # which organisation this deployment serves
CRON_SECRET=replace-with-16+-random-characters           # Bearer token for /api/cron/tick

# --- WhatsApp Business Platform (Cloud API). Leave WHATSAPP_PROVIDER=mock for development: nothing is sent.
WHATSAPP_PROVIDER=mock         # mock | cloud
WHATSAPP_ACCESS_TOKEN=         # System User permanent token (server-side only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=           # Meta app secret, used to verify X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=         # any random string you also enter in Meta's webhook configuration
WHATSAPP_GRAPH_VERSION=v23.0   # check Meta's current supported version

# --- Seeding (development only)
SEED_PASSWORD=                 # password for all demo accounts; defaults to a documented dev value

# --- Tests
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres   # a superuser connection; tests create/drop throw-away databases
